    def calculate_sum(a: int, b: int) -> int:
        """
        Calculates the sum of the two integers provided as arguments.
        
        Args:
            a: The first integer.
            b: The second integer.

        Returns:
            The sum of the two integers.
        """

        # return the sum of the two integers
        return a + b
